{
  "name": "Open Abundance",
  "short_name": "Abundance",
  "description": "Offline-first growth app prototype",
  "start_url": "/",
  "scope": "/",
  "share_target": {
    "action": "/?share-target=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "display": "standalone",
  "background_color": "#f6f7f3",
  "theme_color": "#0f8f72",
  "icons": [
    {
      "src": "/icons/twenty-levels-app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/twenty-levels-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
