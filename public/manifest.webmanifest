{
  "name": "Open Abundance",
  "short_name": "Abundance",
  "description": "Offline-first growth app prototype",
  "start_url": "/",
  "scope": "/",
  "share_target": {
    "action": "/?share-target=1",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "display": "standalone",
  "background_color": "#f6f7f3",
  "theme_color": "#0f8f72",
  "icons": [
    {
      "src": "/icons/twenty-levels-app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/twenty-levels-app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Записать мысль",
      "short_name": "Мысль",
      "description": "Быстро записать мысль в заметки",
      "url": "/?view=goals.notes&quick=capture",
      "icons": [
        {
          "src": "/icons/twenty-levels-app-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Новая задача",
      "short_name": "Задача",
      "description": "Сразу открыть форму новой задачи",
      "url": "/?view=goals.checks&quick=new-task",
      "icons": [
        {
          "src": "/icons/twenty-levels-app-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Разобрать всё",
      "short_name": "Разобрать",
      "description": "Разложить мысли на сейчас, сегодня и позже",
      "url": "/?view=goals.notes&quick=brain-dump",
      "icons": [
        {
          "src": "/icons/twenty-levels-app-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Набор дня",
      "short_name": "Набор дня",
      "description": "Открыть набор дня на главной",
      "url": "/?view=home",
      "icons": [
        {
          "src": "/icons/twenty-levels-app-icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
